<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:clipChildren="false" android:clipToPadding="false"
    android:orientation="vertical">
    <FrameLayout android:id="@+id/stile"
        android:layout_width="150dp" android:layout_height="84dp"
        android:background="@drawable/tile_bg"
        android:focusable="true" android:clickable="true">
        <ImageView android:id="@+id/simg" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <TextView android:id="@+id/stitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:background="@drawable/caption_scrim"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="14dp" android:paddingBottom="5dp"
            android:maxLines="1" android:ellipsize="end"
            android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:textSize="11sp" />
    </FrameLayout>
    <View android:id="@+id/sbar"
        android:layout_width="24dp" android:layout_height="3dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="8dp"
        android:background="@drawable/pill" android:alpha="0" />
</LinearLayout>
