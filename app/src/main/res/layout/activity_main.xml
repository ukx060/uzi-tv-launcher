<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#140C08"
    android:clipChildren="false" android:clipToPadding="false">

    <ImageView android:id="@+id/wall" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/wallpaper" android:importantForAccessibility="no" />

    <!-- Top Shelf: fades as the grid scrolls up -->
    <FrameLayout android:id="@+id/topWrap"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipChildren="false" android:clipToPadding="false">
        <ImageView android:id="@+id/bgA" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:alpha="0" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/bgB" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:alpha="0" android:importantForAccessibility="no" />
        <View android:id="@+id/artScrim" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/scrim" android:alpha="0" />
        <View android:id="@+id/artScrimLeft" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/scrim_left" android:alpha="0" />

        <View android:id="@+id/vignette" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/vignette" />

        <!-- Hero art: no box, edges dissolve into the background; revealed like fog clearing -->
        <FrameLayout android:id="@+id/artFrame"
            android:layout_width="660dp" android:layout_height="372dp"
            android:layout_gravity="top|end" android:alpha="0">
            <ee.uzi.tvlauncher.FadeImageView android:id="@+id/artFog"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <ee.uzi.tvlauncher.FadeImageView android:id="@+id/artCard"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <View android:id="@+id/haze"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/haze" android:alpha="0" />
        </FrameLayout>

        <LinearLayout android:id="@+id/shelfPanel"
            android:layout_width="440dp" android:layout_height="wrap_content"
            android:layout_marginStart="56dp" android:layout_marginTop="100dp"
            android:alpha="0" android:orientation="vertical"
            android:clipChildren="false" android:clipToPadding="false">
            <TextView android:id="@+id/heroSub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:textAllCaps="true" android:letterSpacing="0.1"
                android:textColor="#D9FFF1E0" android:textSize="12sp" />
            <TextView android:id="@+id/heroTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif" android:textStyle="bold" android:letterSpacing="-0.02"
                android:maxLines="2" android:ellipsize="end" android:lineSpacingMultiplier="0.92"
                android:shadowColor="#66000000" android:shadowDy="2" android:shadowRadius="10"
                android:textColor="#FFF6EA" android:textSize="34sp" />
            <TextView android:id="@+id/heroDesc"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end"
                android:lineSpacingMultiplier="1.1"
                android:textColor="#B8FFEEDC" android:textSize="15sp" />
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:clipChildren="false" android:clipToPadding="false" android:orientation="horizontal">
                <TextView android:id="@+id/btnPlay" style="@style/UziButton" android:text="Play"
                    android:drawableStart="@drawable/ic_play" android:drawablePadding="8dp" android:drawableTint="@color/btn_text" />
                <TextView android:id="@+id/btnOpen" style="@style/UziButton" android:layout_marginStart="11dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/dots"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal" />
        </LinearLayout>
    </FrameLayout>

    <TextClock android:id="@+id/clock"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp" android:layout_marginEnd="48dp"
        android:format12Hour="h:mm" android:format24Hour="HH:mm"
        android:fontFamily="sans-serif-medium"
        android:shadowColor="#99140C08" android:shadowDy="2" android:shadowRadius="8"
        android:textColor="#FFFFF6EA" android:textSize="26sp" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:paddingTop="344dp" android:paddingBottom="48dp"
        android:clipChildren="false" android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:overScrollMode="never" android:scrollbars="none" />
</FrameLayout>
